#!/usr/bin/env python3
"""Edit or re-style images with Qwen-Image 2.1 on the Panoptic gateway.

The OpenAI-compatible endpoint is text-to-image only, so this goes through the
gateway's ComfyUI passthrough (/comfy/*) and submits a workflow built around
TextEncodeQwenImage21 with reference-image slots.

Usage:
    qwen-edit ref.png "same icon, flat #2E6BFF, no text"
    qwen-edit base.png logo.png "combine: logo on the base, dark theme"
    qwen-edit ref.png "recolor to teal" --resolution 1536 --seed 7 -o out.png

Stdlib only, no deps.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from datetime import datetime
from pathlib import Path

DEFAULT_BASE_URL = "http://100.110.22.90:9000"
DEFAULT_MODEL_UNET = "qwen_image_2.1_int8_convrot.safetensors"
DEFAULT_MODEL_CLIP = "qwen3vl_8b_int8_convrot.safetensors"
DEFAULT_MODEL_VAE = "qwen_image_2.1_vae_bf16_comfy.safetensors"
KEY_FILE = Path.home() / ".config" / "opencode" / "panoptic-api-key"
DEFAULT_OUTDIR = Path.home() / "Pictures" / "qwen-image"


def api_key() -> str | None:
    key = os.environ.get("PANOPTICLLM_APIKEY", "").strip()
    if key:
        return key
    if KEY_FILE.is_file():
        return KEY_FILE.read_text().strip()
    return None


def request(url: str, data: bytes | None = None, headers: dict | None = None, timeout: int = 900) -> bytes:
    req = urllib.request.Request(url, data=data, headers=headers or {}, method="POST" if data else "GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read()
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")[:600]
        sys.exit(f"error: HTTP {exc.code} from {url}\n{detail}")
    except urllib.error.URLError as exc:
        sys.exit(f"error: cannot reach {url}: {exc.reason}")


def list_outputs(base: str, key: str | None, timeout: int) -> list[str]:
    headers = {"Authorization": f"Bearer {key}"} if key else {}
    raw = request(f"{base}/comfy/internal/files/output", None, headers, timeout)
    return [str(item).strip() for item in (json.loads(raw) or [])]


def resolve_refs(base: str, key: str | None, refs: list[str], timeout: int) -> list[str]:
    """Validate references against the server's output folder.

    The gateway blocks every POST except /comfy/prompt and /comfy/interrupt,
    so /comfy/upload/image is unreachable — a local file cannot be pushed to
    the server. References must already exist in ComfyUI's output directory,
    which is where every image this gateway generates lands.

    LoadImageOutput wants the annotated form ("name.png [output]"), which is
    exactly what the listing returns, so accept a bare or annotated name.
    """
    available = list_outputs(base, key, timeout)
    by_bare = {item.split(" [")[0].strip(): item for item in available}
    names: list[str] = []
    for item in refs:
        if Path(item).expanduser().is_file():
            sys.exit(
                f"error: {item} is a local file, but the gateway blocks image upload.\n"
                "Only images already in the server's ComfyUI output folder can be used\n"
                "as references — generate one with `qwen-image --url` (the URL carries the\n"
                "server filename), or ask the operator to expose /comfy/upload/image.\n"
                f"Available server-side references ({len(by_bare)}): "
                + ", ".join(list(by_bare)[-8:])
            )
        annotated = by_bare.get(item.split(" [")[0].strip())
        if not annotated:
            sys.exit(
                f"error: {item} is not in the server's output folder.\n"
                f"Available ({len(by_bare)}): " + ", ".join(list(by_bare)[-8:])
            )
        names.append(annotated)
    return names


def build_workflow(
    *,
    prompt: str,
    negative: str,
    ref_names: list[str],
    resolution: int,
    seed: int,
    steps: int,
    cfg: float,
    unet: str,
    clip: str,
    vae: str,
    prefix: str,
) -> dict:
    graph: dict[str, dict] = {
        "6": {
            "class_type": "TextEncodeQwenImage21",
            "inputs": {
                "clip": ["11", 0],
                "prompt": prompt,
                "negative_prompt": negative,
                "resolution": resolution,
                "vae": ["12", 0],
            },
        },
        "8": {
            "class_type": "KSampler",
            "inputs": {
                "model": ["10", 0],
                "positive": ["6", 0],
                "negative": ["6", 1],
                "latent_image": ["6", 2],
                "seed": seed,
                "steps": steps,
                "cfg": cfg,
                "sampler_name": "euler",
                "scheduler": "simple",
                "denoise": 1.0,
            },
        },
        "9": {"class_type": "VAEDecode", "inputs": {"samples": ["8", 0], "vae": ["12", 0]}},
        "10": {"class_type": "UNETLoader", "inputs": {"unet_name": unet, "weight_dtype": "default"}},
        "11": {"class_type": "CLIPLoader", "inputs": {"clip_name": clip, "type": "qwen_image"}},
        "12": {"class_type": "VAELoader", "inputs": {"vae_name": vae}},
        "13": {"class_type": "SaveImage", "inputs": {"filename_prefix": prefix, "images": ["9", 0]}},
    }

    # Reference slots. ComfyUI autogrow inputs take FLAT dotted keys
    # ("images.image_1"); a nested {"images": {...}} dict is dropped silently
    # and the job quietly degrades to plain text-to-image.
    for index, name in enumerate(ref_names, start=1):
        node_id = str(100 + index)
        graph[node_id] = {"class_type": "LoadImageOutput", "inputs": {"image": name}}
        graph["6"]["inputs"][f"images.image_{index}"] = [node_id, 0]

    return graph


class JobError(RuntimeError):
    def __init__(self, message: str, oom: bool = False) -> None:
        super().__init__(message)
        self.oom = oom


def wait_for(base: str, key: str | None, prompt_id: str, timeout: int) -> dict:
    headers = {"Authorization": f"Bearer {key}"} if key else {}
    deadline = time.time() + timeout
    while time.time() < deadline:
        raw = request(f"{base}/comfy/history/{prompt_id}", None, headers, 60)
        entry = (json.loads(raw) or {}).get(prompt_id)
        if entry:
            status = entry.get("status") or {}
            if status.get("status_str") == "error":
                blob = json.dumps(status.get("messages") or [])
                oom = "out of memory" in blob.lower() or "allocation on device" in blob.lower()
                raise JobError(blob[:800], oom=oom)
            if entry.get("outputs"):
                return entry
        time.sleep(2)
    raise JobError(f"job {prompt_id} did not finish within {timeout}s")


def download(base: str, key: str | None, image: dict, target: Path, timeout: int) -> None:
    query = urllib.parse.urlencode(
        {
            "filename": image.get("filename", ""),
            "subfolder": image.get("subfolder", ""),
            "type": image.get("type", "output"),
        }
    )
    headers = {"Authorization": f"Bearer {key}"} if key else {}
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(request(f"{base}/comfy/view?{query}", None, headers, timeout))


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Edit images with Qwen-Image 2.1 via the gateway's ComfyUI passthrough.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.add_argument(
        "refs",
        nargs="*",
        help="server-side reference image name(s) from the ComfyUI output folder; "
        "the first one sets the output size",
    )
    parser.add_argument(
        "--list",
        action="store_true",
        help="list the reference images available on the server and exit",
    )
    parser.add_argument("-p", "--prompt", help="edit instruction")
    parser.add_argument("--negative", default="", help="negative prompt")
    parser.add_argument("-o", "--out", help="output PNG (or directory)")
    parser.add_argument(
        "--resolution",
        type=int,
        default=896,
        help="references are resized to ~resolution^2 px (default 896; 1024 can run "
        "out of VRAM and falls back to 768); 0 keeps their own size",
    )
    parser.add_argument("--seed", type=int, default=None)
    parser.add_argument("--steps", type=int, default=20)
    parser.add_argument("--cfg", type=float, default=2.5)
    parser.add_argument("--prefix", default="agent", help="ComfyUI output filename prefix")
    parser.add_argument("--unet", default=DEFAULT_MODEL_UNET)
    parser.add_argument("--clip", default=DEFAULT_MODEL_CLIP)
    parser.add_argument("--vae", default=DEFAULT_MODEL_VAE)
    parser.add_argument(
        "--base-url",
        default=os.environ.get("PANOPTIC_BASE_URL", DEFAULT_BASE_URL).replace("/v1", ""),
        help="gateway root (no /v1)",
    )
    parser.add_argument("--timeout", type=int, default=900)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    refs = [item.strip() for item in args.refs]
    key = api_key()

    if args.list:
        for name in list_outputs(args.base_url, key, args.timeout):
            print(name)
        return

    if not refs:
        sys.exit("error: give at least one reference (see --list)")
    if not args.prompt:
        sys.exit("error: -p/--prompt is required")
    if len(refs) > 16:
        sys.exit("error: at most 16 reference images")

    started = time.time()
    names = resolve_refs(args.base_url, key, refs, args.timeout)

    seed = args.seed if args.seed is not None else uuid.uuid4().int % 2**31
    resolution = args.resolution

    def submit(res: int) -> tuple[str, dict]:
        workflow = build_workflow(
            prompt=args.prompt,
            negative=args.negative,
            ref_names=names,
            resolution=res,
            seed=seed,
            steps=args.steps,
            cfg=args.cfg,
            unet=args.unet,
            clip=args.clip,
            vae=args.vae,
            prefix=args.prefix,
        )
        payload = json.dumps(
            {"prompt": workflow, "client_id": f"qwen-edit-{uuid.uuid4().hex[:8]}"}
        ).encode()
        headers = {"Content-Type": "application/json"}
        if key:
            headers["Authorization"] = f"Bearer {key}"
        accepted = json.loads(request(f"{args.base_url}/comfy/prompt", payload, headers, 60))
        pid = accepted.get("prompt_id")
        if not pid:
            sys.exit(f"error: gateway rejected the workflow: {json.dumps(accepted)[:600]}")
        return pid, wait_for(args.base_url, key, pid, args.timeout)

    try:
        prompt_id, entry = submit(resolution)
    except JobError as exc:
        # Reference latents add VRAM on top of the cached model; the two 3080s
        # (9.65 GiB each) run out around 1024. Step down once instead of failing.
        if not exc.oom or resolution <= 768:
            sys.exit(f"error: ComfyUI job failed: {exc}")
        print(
            f"# out of VRAM at {resolution}px, retrying at 768px",
            file=sys.stderr,
        )
        resolution = 768
        prompt_id, entry = submit(resolution)

    images = [img for out in (entry.get("outputs") or {}).values() for img in out.get("images", [])]
    if not images:
        sys.exit("error: job finished but produced no images")

    target = Path(args.out).expanduser() if args.out else DEFAULT_OUTDIR / (
        f"edit-{datetime.now():%Y%m%d-%H%M%S}.png"
    )
    if target.is_dir():
        target = target / f"edit-{datetime.now():%Y%m%d-%H%M%S}.png"
    if target.suffix == "":
        target = target.with_suffix(".png")
    download(args.base_url, key, images[0], target, args.timeout)

    elapsed = round(time.time() - started, 1)
    if args.json:
        print(
            json.dumps(
                {
                    "path": str(target),
                    "seed": seed,
                    "steps": args.steps,
                    "resolution": resolution,
                    "refs": names,
                    "prompt_id": prompt_id,
                    "elapsed_s": elapsed,
                },
                indent=2,
            )
        )
        return
    print(target)
    print(f"# edit · {len(refs)} ref(s) · {args.resolution}px · seed {seed} · {elapsed}s", file=sys.stderr)


if __name__ == "__main__":
    main()
