{
  "$schema": "https://opencode.ai/config.json",

  // Same default model as the Mac mini. Change with /models if unavailable.
  "model": "opencode-go/deepseek-v4.1-flash",

  // Custom OpenAI-compatible endpoints. Credentials come from environment
  // variables (see env.example) — never hardcode keys in this file.
  "providers": {
    "agnes": {
      "name": "Agnes AI",
      "env": ["AGNES_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://apihub.agnes-ai.com/v1"
      },
      "models": {
        "agnes-2.0-flash": {
          "name": "Agnes 2.0 Flash"
        }
      }
    },
    "sensenova": {
      "name": "SenseNova",
      "env": ["SENSENOVA_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://token.sensenova.cn/v1"
      },
      "models": {
        "sensenova-6.7-flash-lite": { "name": "SenseNova 6.7 Flash Lite" },
        "SenseNova-V6-5-Pro": { "name": "SenseNova V6.5 Pro" },
        "SenseNova-V6-5-Turbo": { "name": "SenseNova V6.5 Turbo" },
        "SenseNova-V6-Pro": { "name": "SenseNova V6 Pro" },
        "SenseNova-V6-Turbo": { "name": "SenseNova V6 Turbo" },
        "SenseNova-V6-Reasoner": { "name": "SenseNova V6 Reasoner" },
        "SenseChat-5": { "name": "SenseChat 5" },
        "nova-embedding-stable": { "name": "Nova Embedding" }
      }
    },
    "mistral": {
      "name": "Mistral",
      "env": ["MISTRAL_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.mistral.ai/v1"
      },
      "models": {
        "mistral-large-latest": { "name": "Mistral Large" },
        "mistral-medium-latest": { "name": "Mistral Medium" },
        "mistral-small-latest": { "name": "Mistral Small" },
        "codestral-latest": { "name": "Codestral" },
        "devstral-medium-latest": { "name": "Devstral Medium" },
        "magistral-medium-latest": { "name": "Magistral Medium" }
      }
    },
    "openxlab": {
      "name": "OpenXLab",
      "env": ["OPENXLAB_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://discovery-api.intern-ai.org.cn/v1"
      },
      "models": {
        "deepseek-v4-flash-0731": { "name": "DeepSeek V4 Flash 0731" },
        "deepseek-v4-flash-vision": { "name": "DeepSeek V4 Flash Vision" },
        "deepseek-v4-pro-0813": { "name": "DeepSeek V4 Pro 0813" },
        "minimax-m3": { "name": "MiniMax M3" },
        "qwen3.8-27b": { "name": "Qwen 3.8 27B" },
        "intern-s2": { "name": "Intern S2" },
        "Agents-A1": { "name": "Agents A1" },
        "glm-5.3": { "name": "GLM 5.3" },
        "kimi-k2.6": { "name": "Kimi K2.6" },
        "Atria-Dawn-Preview": { "name": "Atria Dawn Preview" }
      }
    },
    "atria": {
      "name": "Atria International",
      "env": ["ATRIA_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.atria-asi.ai/v1"
      },
      "models": {
        "Atria-Dawn-Preview": { "name": "Atria Dawn Preview" }
      }
    },
    "ollama": {
      "name": "Ollama (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },

  // Subagents mirrored from the Mac mini.
  "agents": {
    "vision": {
      "model": "opencode-go/kimi-k3",
      "mode": "subagent",
      "description": "Analyzes images, screenshots, diagrams, charts. Use when the main model cannot process image input. Returns detailed text descriptions.",
      "system": "You are a vision specialist. Analyze any image provided and return a thorough text description covering: layout, text content, colors, relationships, data points, UI elements, or any other relevant detail. Be precise and exhaustive. Output only the description — no preamble."
    },
    "architect": {
      "model": "zai-coding-plan/glm-5.3",
      "mode": "subagent",
      "description": "GLM-5.3 architect. Generates implementation plans and reviews diffs against requirements. Resumed across a task for context continuity.",
      "system": "You are the architect in a two-model plan→execute→review→validate loop. The Worker does the hands-on work. You do NOT execute. Your two jobs: (1) Plan: given the task plus relevant file paths/content and constraints, produce a concrete implementation plan — ordered steps, risks, edge cases, what to verify. (2) Code Review: given the original requirements and the full diff, return either `ISSUES: <concrete, actionable list>` or `APPROVED`. Judge the code against requirements and correctness, not against your own plan. Style: pragmatic, concise, actionable. No padding."
    }
  },

  // Remote plugin packages only. Local mini-only plugins are excluded.
  "plugins": ["github:eddy-lau/opencode-file-viewer"],

  "mcp": {
    "servers": {
      "zai-mcp-server": {
        "type": "local",
        "command": ["npx", "-y", "@z_ai/mcp-server@latest"],
        "environment": {
          "Z_AI_API_KEY": "{env:Z_AI_API_KEY}",
          "Z_AI_MODE": "ZAI"
        }
      },
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://github.com/oraios/serena",
          "serena",
          "start-mcp-server",
          "--project-from-cwd",
          "--context",
          "ide",
          "--open-web-dashboard",
          "False"
        ]
      }
    }
  }
}
