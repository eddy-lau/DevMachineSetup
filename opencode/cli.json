{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "markdown": "rendered",
    "verbosity": "medium",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "scope": "cwd"
  },
  "debug": {
    "devtools": false
  }
}
